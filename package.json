{
  "name": "nos-fiches-hellofresh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Le site de recettes HelloFresh de papa et maman. Lancer : npm run dev",
  "workspaces": [
    "nos-fiches"
  ],
